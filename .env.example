DATABASE_URL=postgres://user:pass@localhost:5432/foodai
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# Django settings module: dev (local/test) or prod (deployment)
DJANGO_SETTINGS_MODULE=foodai_backend.settings.dev
# Comma-separated hosts allowed to serve requests (required when DEBUG=False)
# e.g. ALLOWED_HOSTS=.onrender.com,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_AUTH_BYPASS=false

# Firebase Admin SDK (Backend)
FIREBASE_ADMIN_SDK_KEY_PATH=path/to/service-account-key.json

# Open Food Facts API (barcode lookups)
# OFF asks for a descriptive User-Agent with a real contact so they can reach us
# instead of blocking. All lookups are cached; a sensible UA is the built-in default.
# OFF_USER_AGENT=YourApp/1.0 (https://your.site; you@example.com)

# Per-scope rate limits (anonymous / authenticated), enforced by DRF throttling.
# Defaults shown; only override to loosen/tighten.
# THROTTLE_SCAN_ANON=30/min
# THROTTLE_SCAN_USER=120/min
# THROTTLE_OCR_ANON=10/min
# THROTTLE_OCR_USER=60/min
# THROTTLE_CATALOG_ANON=60/min
# THROTTLE_CATALOG_USER=200/min

# Max accepted OCR/label image upload size in bytes (default 8 MB).
# OCR_MAX_UPLOAD_BYTES=8388608

# CORS
# Only relevant for dev. In prod (settings/prod.py) CORS_ALLOW_ALL_ORIGINS is
# forced False and CORS_ALLOWED_ORIGINS MUST be set to your real frontend origin(s).
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Production (settings/prod.py) ----
# Shared cache so rate-limiting + Open Food Facts caching work across workers.
# Strongly recommended when running more than one process; leave unset for the
# single-process dev fallback (LocMemCache).
# REDIS_URL=redis://default:your-redis-password@your-host:6379

# Transport security (prod defaults are secure; override only if needed).
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# In prod, CORS_ALLOWED_ORIGINS above must list your real deployed origin(s).
