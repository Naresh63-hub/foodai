{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with dietary preferences and physical metrics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "age": { "type": "integer" },
        "bodyWeightKg": { "type": "number" },
        "healthConditions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "FoodScan": {
      "title": "FoodScan",
      "description": "A food scan or photo snapshot analyzed by Gemini AI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "foodName": { "type": "string", "maxLength": 256 },
        "caloriesKcal": { "type": "number" },
        "servingDescription": { "type": "string", "maxLength": 256 },
        "servingWeightG": { "type": "number" },
        "macros": { "type": "object" },
        "healthScore": { "type": "integer" },
        "processingLevel": { "type": "string", "maxLength": 64 },
        "glycemicImpact": { "type": "string", "maxLength": 32 },
        "ingredients": { "type": "array" },
        "imageUrl": { "type": "string", "maxLength": 4096 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "foodName", "caloriesKcal", "createdAt"]
    },
    "DailyLog": {
      "title": "DailyLog",
      "description": "Daily food intake record for tracking WHO nutrient limits",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 256 },
        "portionG": { "type": "number" },
        "sugarsG": { "type": "number" },
        "saltG": { "type": "number" },
        "fatG": { "type": "number" },
        "additivesCount": { "type": "integer" },
        "processingLevel": { "type": "string", "maxLength": 64 },
        "dateKey": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "productName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and dietary settings"
    },
    "/users/{userId}/foodScans/{scanId}": {
      "schema": { "$ref": "#/entities/FoodScan" },
      "description": "User's captured food photos and AI nutritional analyses"
    },
    "/users/{userId}/dailyLogs/{logId}": {
      "schema": { "$ref": "#/entities/DailyLog" },
      "description": "Logged food entries for the 24-hour nutrition tracker"
    }
  }
}
